<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse">

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- ================= Perimeter walls ================= -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>30 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>30 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.62 1</ambient><diffuse>0.75 0.72 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>30 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>30 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.62 1</ambient><diffuse>0.75 0.72 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>15 0 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.62 1</ambient><diffuse>0.75 0.72 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-15 0 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.62 1</ambient><diffuse>0.75 0.72 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Shelf racks (static boxes, two aisles) ================= -->

    <model name="shelf_rack_1">
      <static>true</static>
      <pose>-6.0 5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_rack_2">
      <static>true</static>
      <pose>-6.0 -5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_rack_3">
      <static>true</static>
      <pose>-2.0 5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_rack_4">
      <static>true</static>
      <pose>-2.0 -5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_rack_5">
      <static>true</static>
      <pose>2.0 5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_rack_6">
      <static>true</static>
      <pose>2.0 -5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_rack_7">
      <static>true</static>
      <pose>6.0 5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_rack_8">
      <static>true</static>
      <pose>6.0 -5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 3.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Pallets / boxes scattered near the aisles ================= -->
    <model name="pallet_1">
      <static>true</static>
      <pose>3.5 1.5 0.15 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.2 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.2 0.3</size></box></geometry>
          <material><ambient>0.65 0.5 0.3 1</ambient><diffuse>0.65 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pallet_2">
      <static>true</static>
      <pose>-3.5 -1.8 0.15 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.2 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.2 0.3</size></box></geometry>
          <material><ambient>0.65 0.5 0.3 1</ambient><diffuse>0.65 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_box_movable_demo">
      <!-- Convenience prop for Scenario 2 (obstacle-in-path): move this
           model with `ros2 run gazebo_ros spawn_entity.py` args or drag
           it in the Gazebo GUI in front of the robot. Kept static by
           default so it doesn't drift during normal demos. -->
      <static>true</static>
      <pose>2.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Loading / charging zone marking ================= -->
    <model name="charging_station_marker">
      <static>true</static>
      <pose>-11 8 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.0 2.0 0.02</size></box></geometry>
          <material><ambient>0.1 0.6 0.9 0.8</ambient><diffuse>0.1 0.6 0.9 0.8</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
